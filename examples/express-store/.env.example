# Create a TEST-mode API key in the merchant dashboard (API Keys → toggle
# "Test" → New API key) and a webhook endpoint pointing at
# http://localhost:4242/webhooks/payment-gateway (Webhooks tab).
PG_API_KEY=pk_test_...
PG_API_SECRET=sk_test_...
PG_WEBHOOK_SECRET=whsec_...

# Gateway API base. localhost:5000 for a locally-running backend; the
# production URL only works for webhooks if this server is publicly
# reachable (use a tunnel like cloudflared for local webhook testing).
PG_BASE_URL=http://localhost:5000

# Optional: override the hosted checkout base (e.g. a local checkout UI).
# PG_CHECKOUT_URL=http://localhost:5200

PORT=4242
